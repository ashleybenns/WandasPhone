# Copy to keystore.properties (same folder as this file) and fill in.
# keystore.properties is gitignored — never commit real passwords or the .keystore file.

storeFile=release.keystore
storePassword=mjK23asP
keyAlias=toms-phone
keyPassword=mjK23asP

# Create the keystore once (from repo root), then keep release.keystore backed up safely:
#
#   keytool -genkeypair -v -keystore release.keystore -alias toms-phone \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Use the same upload key in Play Console (App signing) when you first upload the AAB.
